// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("customer")  
  cart      Cart?
  orders    Order[]
  wishlist  WishlistItem[]
  reviews   Review[]
  createdAt DateTime @default(now())
}

enum Condition {
  NEW
  USED
}

model Vehicle {
  id          Int       @id @default(autoincrement())
  brand       String
  model       String
  year        Int
  price       Float
  range       Int
  color       String
  quantity    Int       @default(0)
  imageUrls   String[]  @default([])
  description String?
  isActive    Boolean   @default(true)
  isHotDeal   Boolean   @default(false)
  condition   Condition @default(NEW)
  mileage     Int?

  availableColors         String[] @default([])
  availableInteriorColors String[] @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  reviews        Review[]
  historyRecords VehicleHistoryRecord[]
}

model VehicleHistoryRecord {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  eventType   String
  description String
  eventDate   DateTime
  createdAt   DateTime @default(now())
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id])
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  quantity  Int      @default(1)

  selectedColor         String?
  selectedInteriorColor String?

  createdAt DateTime @default(now())

  @@unique([cartId, vehicleId])
}

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int
  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
  totalPrice Float
  status     String      @default("pending")
  createdAt  DateTime    @default(now())
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  order      Order   @relation(fields: [orderId], references: [id])
  vehicleId  Int
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  quantity   Int
  priceAtPurchase Float

  selectedColor         String?
  selectedInteriorColor String?
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
}